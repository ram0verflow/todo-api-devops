#!/bin/sh
### BEGIN INIT INFO
# Provides:          {{ app_name }}
# Required-Start:    $network
# Required-Stop:     $network
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: {{ app_name }} Spring Boot service
### END INIT INFO
# Managed by Ansible - do not edit by hand

NAME={{ app_name }}
JAR={{ app_dir }}/{{ app_name }}.jar
PIDFILE={{ app_pidfile }}
LOG={{ app_log }}
export APP_PORT={{ app_port }}
export APP_MESSAGE="{{ app_message }}"

start() {
  if [ -f "$PIDFILE" ] && kill -0 "$(cat $PIDFILE)" 2>/dev/null; then
    echo "$NAME already running"; return 0
  fi
  echo "Starting $NAME on port $APP_PORT"
  start-stop-daemon --start --background --make-pidfile --pidfile "$PIDFILE" \
    --chuid {{ app_user }} --startas /bin/sh -- -c "exec java -jar $JAR >> $LOG 2>&1"
}

stop() {
  echo "Stopping $NAME"
  start-stop-daemon --stop --quiet --retry 15 --pidfile "$PIDFILE" --remove-pidfile || true
}

status() {
  if [ -f "$PIDFILE" ] && kill -0 "$(cat $PIDFILE)" 2>/dev/null; then
    echo "$NAME is running (pid $(cat $PIDFILE))"; return 0
  fi
  echo "$NAME is not running"; return 3
}

case "$1" in
  start) start ;;
  stop) stop ;;
  restart) stop; start ;;
  status) status ;;
  *) echo "Usage: $0 {start|stop|restart|status}"; exit 1 ;;
esac
